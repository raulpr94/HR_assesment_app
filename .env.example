# Copy this file to .env (the setup scripts do it for you). Never commit .env.
# Values can also come from environment variables or .streamlit/secrets.toml.

# SQLite database file (relative paths are resolved from the project folder)
PERF_DB_PATH=data/app.db

# Notifications: dry_run (default, nothing is sent) or zapier
NOTIFY_MODE=dry_run
ZAPIER_WEBHOOK_URL=
ZAPIER_TIMEOUT_SECONDS=10
ZAPIER_MAX_RETRIES=3

# Time zone used to display dates and to check meeting dates against the cycle
APP_TIMEZONE=Europe/Berlin

# When the reviewee may see the manager's answers:
#   meeting_date (from the meeting day onward), meeting_time (from the meeting start),
#   completed (only after both acknowledged)
REVEAL_MANAGER_ANSWERS=meeting_date

# Length of the review meeting in calendar invites
MEETING_DURATION_MINUTES=60

# Login: "simulated" shows the "View as" dropdown. Real auth plugs in here later.
AUTH_PROVIDER=simulated

# Link used in notification emails
APP_BASE_URL=http://localhost:8501

LOG_LEVEL=INFO
